# Copy to .env.local and fill in. Never commit .env.local.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aurum?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/aurum?schema=public"
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me"
# Used only by scripts/access-check.ts (credentials of the seeded users)
SEED_ADMIN_EMAIL="admin@aurum.example"
SEED_ADMIN_PASSWORD="Admin#2026Aurum"
SEED_CLIENT_EMAIL="client@aurum.example"
SEED_CLIENT_PASSWORD="Client#2026Aurum"
