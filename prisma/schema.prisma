generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


enum Role {
  CLIENT
  ADMIN
}

enum Collection {
  CLASSIC
  MODERN
  YACHT
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum InquiryStatus {
  NEW
  HANDLED
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(CLIENT)
  createdAt    DateTime   @default(now())
  bookings     Booking[]
  auditLogs    AuditLog[]

  @@map("users")
}

model FleetItem {
  id             String     @id @default(cuid())
  name           String
  collection     Collection
  description    String
  specifications String
  history        String
  condition      String
  pricePerDay    Decimal    @db.Decimal(10, 2)
  imageUrl       String
  isActive       Boolean    @default(true)
  bookings       Booking[]

  @@map("fleet_items")
}

model Booking {
  id          String        @id @default(cuid())
  userId      String
  fleetItemId String
  startDate   DateTime      @db.Date
  endDate     DateTime      @db.Date
  status      BookingStatus @default(PENDING)
  notes       String?
  createdAt   DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id])
  fleetItem   FleetItem     @relation(fields: [fleetItemId], references: [id])

  @@index([fleetItemId, startDate, endDate])
  @@index([userId])
  @@map("bookings")
}

model Inquiry {
  id        String        @id @default(cuid())
  name      String
  email     String
  message   String
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())

  @@map("inquiries")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}
